{
  "name": "dsh-plugin-company-pack",
  "version": "0.1.0-dev.0",
  "private": true,
  "description": "Optional Company Pack umbrella for AI Buddy — confirm-to-install, never silent",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./install": {
      "types": "./lib/types/install.d.ts",
      "default": "./lib/install.js"
    },
    "./manifest": {
      "types": "./lib/types/manifest.d.ts",
      "default": "./lib/manifest.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "cordis.patch.yml",
    "lib/**/*.js",
    "lib/**/*.map",
    "lib/types/**/*.d.ts",
    "README.md"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "node scripts/clean.mjs && tsdown && tsc -p tsconfig.json --emitDeclarationOnly",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tests.json --noEmit",
    "test": "vitest run",
    "check": "yarn run build && yarn run typecheck && yarn run test"
  },
  "dependencies": {
    "dsh-plugin-company-example": "hopefullstack-collab/dsh-plugin-company-example#0202b2c5b93bd3fb494435034e6d43f910a4526f"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@types/node": "^22.20.0",
    "tsdown": "0.22.2",
    "typescript": "6.0.3",
    "vitest": "4.1.8"
  }
}
